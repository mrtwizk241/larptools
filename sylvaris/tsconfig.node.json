{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vite.app.ts",
    "vite.public.config.ts",
    "playwright.public.config.ts",
    "tests",
    "src/engine",
    "src/data",
    "src/api/contract.ts",
    "src/io",
    "src/ui/test/sampleCharacters.ts"
  ],
  "exclude": ["src/io/**/*.test.ts"]
}
